<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Page Title</title>
    <link rel="stylesheet" href="path/to/bootstrap.css">
    <script>
        let input = {
            name: '',
            email: '',
            number: ''
        };

        function handleSubmit(event) {
            event.preventDefault();

            // Access input values
            const name = document.getElementById('InputName').value;
            const email = document.getElementById('InputEmail').value;
            const number = document.getElementById('InputNumber').value;

            // Update the input object
            input.name = name;
            input.email = email;
            input.number = number; 

            // Display the input data
            updateDisplay();

            alert(`Form submitted!
            Name: ${input.name}
            Email: ${input.email}
            Number: ${input.number}`);
        }

        function newStudent() {
            // Reset input object and clear form fields
            input = { name: '', email: '', number: '' };
            document.getElementById('InputName').value = '';
            document.getElementById('InputEmail').value = '';
            document.getElementById('InputNumber').value = '';
            updateDisplay();
        }

        function updateDisplay() {
            document.getElementById('displayName').innerText = input.name;
            document.getElementById('displayEmail').innerText = input.email;
            document.getElementById('displayNumber').innerText = input.number; 
        }
    </script>
</head>
<body>

    <form id="IPromo-form" onsubmit="handleSubmit(event)">
        <div class="row">
            <div class="col-2">
                <div class="form-floating">
                    <input type="text" id="InputName" class="form-control" placeholder="Name" />
                    <label for="InputName">Name</label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-2">
                <div class="form-floating">
                    <input type="email" id="InputEmail" class="form-control" placeholder="Email" />
                    <label for="InputEmail">Email</label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-2">
                <div class="form-floating">
                    <input type="text" id="InputNumber" class="form-control" placeholder="Number" />
                    <label for="InputNumber">Number</label>
                </div>
            </div>
        </div>

        <button class="btn btn-primary" type="submit">Save</button>
        <button class="btn btn-secondary" type="button" onclick="newStudent()">New</button>
    </form>

    <div>
        <p>Name: <span id="displayName"></span></p>
        <p>Email: <span id="displayEmail"></span></p>
        <p>Number: <span id="displayNumber"></span></p>
    </div>
</body>
</html>

